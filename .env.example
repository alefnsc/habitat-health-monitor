HUB_HTTP_HOST=0.0.0.0
HUB_HTTP_PORT=8000
HUB_CORS_ORIGINS=*
HUB_FEATURES=nasa,iss,wearable,mcp,ble,serial,food
HUB_LINKSIM_URL=http://127.0.0.1:8200
