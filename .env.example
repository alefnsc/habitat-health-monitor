# Copy to .env and fill in locally. Never commit .env.
HUB_DB=var/hub.db
HUB_MQTT_HOST=127.0.0.1
HUB_MQTT_PORT=1883
HUB_MQTT_USER=habitat
HUB_MQTT_PASS=
HUB_SERIAL_PORT=
HUB_SERIAL_BAUD=250000
HUB_THRESHOLDS=data/thresholds.json
HUB_GUIDANCE=data/guidance.json
HUB_FOOD_CATALOG=data/food/catalog.json
HUB_FOOD_THRESHOLDS=data/food/thresholds_food.json
HUB_FOOD_REFERENCES=data/food/references.json
HUB_CONSOLE_DIST=console/dist
HUB_CAMERA_DIST=camera/dist
HUB_CREWS=crew-a,crew-b,crew-c
HUB_MORNING_AT=07:00
HUB_TZ=America/Sao_Paulo
HUB_HTTP_HOST=0.0.0.0
HUB_HTTP_PORT=8000
HUB_CORS_ORIGINS=*
HUB_FEATURES=nasa,iss,wearable,mcp,ble,serial,food
HUB_LINKSIM_URL=http://127.0.0.1:8200
HUB_LINK_CONFIG=linksim/link.json
# Personal keys from api.nasa.gov and api.data.gov. Never DEMO_KEY, never committed.
NASA_API_KEY=
USDA_FDC_API_KEY=

# Cabin node on the Pi (nodes/cabin_pi). CABIN_DHT_GPIO is a BCM pin number; empty = no DHT22.
CABIN_I2C_BUS=1
CABIN_DHT_GPIO=
CABIN_STATE_DIR=var

# Wearable ring importer (nodes/ring, D41). Values for the URLs: DATA_SOURCES.md, "Wearable ring".
# The client id and secret come from the ring's developer portal; never commit them.
RING_API_BASE=
RING_AUTHORIZE_URL=
RING_TOKEN_URL=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=http://127.0.0.1:8765/callback

# Public ground segment (D38). Empty PUBLIC_GROUND_URL = no public destination.
PUBLIC_GROUND_URL=
# Comma list of crew ids whose body data may go public. Only adults with a signed consent form. Never minors.
PUBLIC_CREWS=
PUBLIC_REPS=0
PUBLIC_FLUSH_S=10
GROUND_INGEST_SECRET=
