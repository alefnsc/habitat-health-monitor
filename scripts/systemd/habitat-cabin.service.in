[Unit]
Description=Habitat cabin-1 node (BME280, SCD41, optional DHT22 on this Pi)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
ExecStart=@REPO@/.venv/bin/python -m nodes.cabin_pi
Restart=always
RestartSec=5
SupplementaryGroups=i2c gpio

[Install]
WantedBy=multi-user.target
