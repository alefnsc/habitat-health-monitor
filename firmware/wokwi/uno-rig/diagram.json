  "connections": [
    [
      "dht:VCC",
      "uno:5V",
      "red",
      [
        "v0"
      ]
    ],
    [
      "dht:GND",
      "uno:GND.1",
      "black",
      [
        "v0"
      ]
    ],
    [
      "dht:SDA",
      "uno:2",
      "green",
      [
        "v0"
      ]
    ],
    [
      "buzzer:2",
      "uno:8",
      "purple",
      [
        "v0"
      ]
    ],
    [
      "buzzer:1",
      "uno:GND.2",
      "black",
      [
        "v0"
      ]
    ]
  ],
  "dependencies": {}
