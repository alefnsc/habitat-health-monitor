{
  "version": 1,
  "author": "Habitat Health Monitor team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-arduino-uno",
      "id": "uno",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -125,
      "left": 150,
      "attrs": {
        "temperature": "24",
        "humidity": "40"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -60,
      "left": 650,
      "attrs": {
        "volume": "0.1"
      }
    },
    {
      "type": "wokwi-text",
      "id": "label_dht",
      "top": -160,
      "left": 60,
      "attrs": {
        "text": "DHT11 stand-in (simulated) DHT22: D2 → cabin_temp, cabin_rh (node cabin-1), estimate"
      }
    },
    {
      "type": "wokwi-text",
      "id": "label_buzzer",
      "top": -95,
      "left": 600,
      "attrs": {
        "text": "Alarm buzzer: D8 ← hub command"
      }
    },
    {
      "type": "wokwi-text",
      "id": "panel_1",
      "top": 390,
      "left": -60,
      "attrs": {
        "text": "UNO I/O board twin: the same code as the real Arduino Uno (firmware/exercise-uno), decision D40"
      }
    },
    {
      "type": "wokwi-text",
      "id": "panel_2",
      "top": 412,
      "left": -60,
      "attrs": {
        "text": "Role: reads cabin temperature and humidity (DHT11) and sounds the habitat alarm on hub commands"
      }
    },
    {
      "type": "wokwi-text",
      "id": "panel_3",
      "top": 434,
      "left": -60,
      "attrs": {
        "text": "Link: USB serial 250000 baud to the hub, one contract-v1 JSON line per reading; commands in, one ack each"
      }
    },
    {
      "type": "wokwi-text",
      "id": "panel_4",
      "top": 456,
      "left": -60,
      "attrs": {
        "text": "Config: DHT11 and buzzer on; HX711, servo, NTC, KY-039 compiled out. wokwi_twin.h sets the DHT22 stand-in and tone() buzzer"
      }
    },
    {
      "type": "wokwi-text",
      "id": "panel_5",
      "top": 478,
      "left": -60,
      "attrs": {
        "text": "Simulated parts are labelled. Readings are estimates. Not a medical device."
      }
    }
