{
  "name": "BMP280 barometer (I2C 0x76)",
  "author": "Habitat Health Monitor team",
  "pins": ["VCC", "GND", "SCL", "SDA", "CSB", "SDO"],
  "controls": [
    { "id": "pressure", "label": "Pressure (hPa)", "type": "range", "min": 300, "max": 1100, "step": 0.5 },
    { "id": "temperature", "label": "Temperature (C)", "type": "range", "min": -40, "max": 85, "step": 0.5 }
  ]
}
